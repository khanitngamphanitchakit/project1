# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# บน Vercel ให้ไปใส่ที่ Settings > Environment Variables

# จำเป็น: ใช้เซ็น session cookie ของ next-auth (proxy.ts รันทุก request)
# สร้างใหม่ได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ฐานข้อมูล SQLite สำหรับ dev ในเครื่อง
# (ตอนนี้ยังไม่มีหน้าไหนเรียกใช้ จึงยังไม่ต้องตั้งบน Vercel)
DATABASE_URL="file:./dev.db"
